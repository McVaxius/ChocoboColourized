<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.0.3</Version>
    <FileVersion>2.0.0.3</FileVersion>
    <AssemblyVersion>2.0.0.3</AssemblyVersion>
    <PackageProjectUrl>https://github.com/McVaxius/ChocoboColourized</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <DalamudLibPath Condition="$(DALAMUD_HOME) != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\aethertekUI\src\AethertekUI\AethertekUI.csproj" />
    <ProjectReference Include="..\..\aethertekUI\src\AethertekUI.Dalamud\AethertekUI.Dalamud.csproj" />
    <EmbeddedResource Update="Localization\Strings_*.resx" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="images\icon.png" LogicalName="ChocoboColourized.images.icon.png" />
  </ItemGroup>

  <Target Name="CopyPluginArtifacts" AfterTargets="Build">
    <PropertyGroup>
      <PluginOutput>$(OutputPath)$(AssemblyName)</PluginOutput>
    </PropertyGroup>

    <MakeDir Directories="$(PluginOutput)" />

    <ItemGroup>
      <PluginFiles Include="$(TargetPath)" />
      <PluginFiles Include="$(TargetDir)AethertekUI.dll" />
      <PluginFiles Include="$(TargetDir)AethertekUI.Dalamud.dll" />
      <PluginFiles Include="$(ProjectDir)$(AssemblyName).json" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)"
          DestinationFolder="$(PluginOutput)" />
  </Target>
</Project>
